{
  "permissions": {
    "deny": [
      "Edit(notes.md)"
    ],
    "ask": [
      "Edit(raw/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/scripts/hooks/main_md_checks.py\"",
            "timeout": 60,
            "statusMessage": "Checking main.md"
          }
        ]
      }
    ]
  }
}
